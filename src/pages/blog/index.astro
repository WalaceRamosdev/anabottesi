---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

export const prerender = false;

const allPosts = await getCollection("posts");

const now = new Date();
const publishedPosts = allPosts.filter((post) => post.data.publishDate <= now);

const sortedPosts = publishedPosts.sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
import abstractImg from "../../assets/abstract-psychology.svg";
import anaBlogImg from "../../assets/profissional/newAnaBlog.jpg";
---

<Layout title="Blog | Ana Bottesi - Insights para sua transformação">
    <Header />
    <main class="pt-32 bg-brand-bg min-h-screen">
        <div
            class="max-w-7xl mx-auto px-4 md:px-8 py-16 relative overflow-hidden"
        >
            <div
                class="grid lg:grid-cols-12 gap-14 lg:gap-20 items-center mb-20 relative z-10"
            >
                <div class="lg:col-span-5">
                    <div
                        class="h-px w-20 bg-brand-primary mb-10"
                    >
                    </div>
                    <h1
                        class="font-serif text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-none mb-8"
                    >
                        Blog
                    </h1>
                    <div class="w-16 h-[3px] bg-brand-secondary mb-8"></div>
                    <p
                        class="text-xl md:text-2xl text-brand-text/70 leading-relaxed"
                    >
                        Reflexões sobre psicanálise.
                    </p>
                </div>
                <div class="lg:col-span-7">
                    <div class="relative max-w-md mx-auto lg:ml-auto">
                        <div
                            class="absolute -inset-4 border border-brand-primary/25 rounded-3xl translate-x-5 translate-y-5 pointer-events-none"
                        >
                        </div>
                        <div
                            class="absolute -inset-4 border border-brand-secondary/30 rounded-3xl -translate-x-5 -translate-y-5 pointer-events-none"
                        >
                        </div>
                        <div
                            class="relative aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl shadow-brand-primary/20 border border-brand-primary/10 bg-brand-primary/5"
                        >
                            <img
                                src={anaBlogImg.src}
                                alt="Ana Bottesi Psicanalista"
                                class="w-full h-full object-cover"
                            />
                        </div>
                        <div
                            class="absolute -bottom-8 -right-8 w-40 h-40 bg-brand-secondary/20 rounded-full blur-3xl pointer-events-none"
                        >
                        </div>
                    </div>
                </div>
            </div>

            <!-- Elemento Decorativo Abstrato -->
            <div
                class="absolute top-10 right-0 w-96 h-96 opacity-10 pointer-events-none"
            >
                <img
                    src={abstractImg.src}
                    alt=""
                    class="w-full h-full object-contain rotate-12"
                />
            </div>

            <div
                class="flex items-center gap-6 mb-14 relative z-10"
            >
                <span class="h-px flex-1 bg-gradient-to-r from-transparent to-brand-primary/30"></span>
                <span class="w-2 h-2 bg-brand-primary rotate-45"></span>
                <span class="h-px flex-1 bg-gradient-to-l from-transparent to-brand-primary/30"></span>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-12">
                {
                    sortedPosts.map((post) => (
                        <article class="flex flex-col h-full bg-white rounded-3xl overflow-hidden border border-brand-primary/10 shadow-sm hover:shadow-xl transition-all group">
                            <a
                                href={`/blog/${post.slug}`}
                                class="block aspect-video overflow-hidden"
                            >
                                {post.data.image ? (
                                    <img
                                        src={post.data.image}
                                        alt={post.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center text-brand-primary/20 bg-brand-primary/5">
                                        <span class="text-6xl">🦋</span>
                                    </div>
                                )}
                            </a>
                            <div class="p-8 flex flex-col flex-grow">
                                <div class="flex items-center gap-2 mb-4 text-xs font-bold text-brand-primary uppercase">
                                    <span>
                                        {post.data.publishDate.toLocaleDateString(
                                            "pt-BR",
                                        )}
                                    </span>
                                </div>
                                <h2 class="text-2xl font-bold mb-4 group-hover:text-brand-primary transition-colors title-drop-cap">
                                    <a href={`/blog/${post.slug}`}>
                                        {post.data.title}
                                    </a>
                                </h2>
                                <p class="text-brand-text/70 mb-8 line-clamp-3">
                                    {post.data.description}
                                </p>
                                <div class="mt-auto">
                                    <a
                                        href={`/blog/${post.slug}`}
                                        class="btn-secondary w-full block"
                                    >
                                        Ver artigo completo
                                    </a>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </main>
    <Footer />
</Layout>
